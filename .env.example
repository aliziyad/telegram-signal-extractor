# Telegram Configuration
TELEGRAM_API_ID=YOUR_TELEGRAM_API_ID
TELEGRAM_API_HASH=YOUR_TELEGRAM_API_HASH
TELEGRAM_PHONE=YOUR_PHONE_NUMBER

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/signal_extractor

# Supabase Configuration
SUPABASE_INGEST_URL=https://zcdggtjwrtrqhqrngfau.supabase.co/functions/v1/ingest-copy-signal
SUPABASE_API_KEY=YOUR_SUPABASE_API_KEY
COPY_SIGNAL_API_KEY=YOUR_COPY_SIGNAL_API_KEY

# AI API Keys
CLAUDE_API_KEY=YOUR_CLAUDE_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Parsing Configuration
REGEX_ENABLED=true
CLAUDE_ENABLED=true
GEMINI_ENABLED=false
OPENAI_ENABLED=false

# Schedule Configuration (Maldives Time: UTC+4)
SCHEDULE_START=04:00
SCHEDULE_END=22:00
TIMEZONE=Asia/Male

# Flask Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
SECRET_KEY=your-secret-key-change-in-production

# Extraction Configuration
MAX_CHANNELS=100
BATCH_SIZE=10
EXTRACTION_TIMEOUT=30

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/signal_extractor.log
